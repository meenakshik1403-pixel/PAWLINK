# ==============================================================================
# PawLink Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' at the project root (which is gitignored).
#
# When configured, the Spring Boot Backend connects to your shared
# Online Supabase database over SSL so all developers across the internet
# use the exact same data.
#
# If left commented or empty, PawLink automatically falls back to the
# zero-setup embedded H2 database (PostgreSQL mode) with auto-seeding.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Online Database Credentials (HikariCP JDBC Connection)
# ------------------------------------------------------------------------------
# In your Supabase Dashboard -> Project Settings -> Database -> Connection string:
# Choose "Transaction pooler" or "Session pooler" (Port 6543) or direct (Port 5432).
#
# Example (Session Pooler):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.your-project-ref
# SPRING_DATASOURCE_PASSWORD=your-database-password
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# ------------------------------------------------------------------------------
# 2. Supabase CLI Configuration (Optional)
# ------------------------------------------------------------------------------
# Find your Project Ref ID in Supabase project URL (e.g. app.supabase.com/project/<ref>)
# SUPABASE_PROJECT_ID=your-project-ref
# SUPABASE_ACCESS_TOKEN=your-personal-access-token

